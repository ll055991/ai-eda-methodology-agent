{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemp.dev/contracts/run-list.json",
  "title": "Run history page",
  "description": "GET /api/v1/runs response. Backed by the SQLite index (a rebuildable query cache over the run directories).",
  "type": "object",
  "required": ["runs", "limit", "offset"],
  "additionalProperties": false,
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "lifecycle_status", "operation", "created_at", "engineering_status"],
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
          },
          "lifecycle_status": { "enum": ["created", "running", "success", "failed"] },
          "operation": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "minLength": 1 },
          "engineering_status": {
            "enum": ["pass", "fail", "unknown", "success", "failed"],
            "description": "QA verdict vocabulary (pass/fail/unknown, M5) plus the M1-era synonyms (success/failed)."
          }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1 },
    "offset": { "type": "integer", "minimum": 0 }
  }
}
